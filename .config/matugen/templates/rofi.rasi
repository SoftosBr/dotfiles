* {
    background: {{colors.surface.default.hex}};
    background-alt: {{colors.surface_container_low.default.hex}};
    foreground: {{colors.on_surface.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-active: {{colors.primary.default.hex}};
    border: {{colors.outline.default.hex}};
    input-background: {{colors.surface_container_high.default.hex}};
    input-foreground: {{colors.on_surface.default.hex}};
    selected-background: {{colors.primary_container.default.hex}};
    selected-foreground: {{colors.on_primary_container.default.hex}};
}
